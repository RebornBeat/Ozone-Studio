{
  "manifest_version": 3,
  "name": "Ozone-Studio Monitor",
  "version": "0.1.0",
  "description": "Browser observer for Ozone-Studio \u2014 registers as an agent, heartbeats, and pushes browsing activity into the monitor hub. The browser-side seed of the movement graph.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ozone-Studio Monitor"
  },
  "options_page": "options.html",
  "browser_specific_settings": {
    "gecko": {
      "id": "ozone-monitor@ozonestudio.xyz",
      "strict_min_version": "115.0"
    }
  }
}