        "categories": [
          "security",
          "performance",
          "maintainability",
          "correctness",
          "style"
        ],
        "severity_levels": [
          "critical",
          "major",
          "minor",
          "suggestion"
        ]
      },
      "legacy_description": "Organize review findings by severity and category",
      "legacy_action": "structure_review"
    },
