        "OnGraphCreated"
      ],
      "legacy_pipeline_id": 101
    },
    "3": {
      "name": "compute_dependencies",
      "inputs": [
        "code_graph_id"
      ],
      "outputs": [
        "dependency_map"
      ],
      "legacy_pipeline_id": 101
    },
    "4": {
      "name": "semantic_analysis",
      "inputs": [
        "code_graph_id"
      ],
      "outputs": [
        "enriched_graph_id"
      ],
      "config": {
        "hook_type": "OnInferRelationships",
        "semantic_depth": "deep",
        "analyze_patterns": true
      },
      "legacy_pipeline_id": 10
    },
    "5": {
      "name": "load_methodologies",
      "inputs": [
        "required_methodologies",
        "suggested_methodologies"
      ],
      "outputs": [
