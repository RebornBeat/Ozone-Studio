      "pipeline_id": 9,
      "inputs": [
        "review_prompt_context"
      ],
      "outputs": [
        "raw_review"
      ],
      "config": {
        "response_format": "structured",
        "include_graph_references": true
      },
      "legacy_description": "Generate code review using LLM with graph context",
      "legacy_action": "Execute"
    },
    "9": {
      "name": "structure_findings",
      "pipeline_id": 1,
      "inputs": [
