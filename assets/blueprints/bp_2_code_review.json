      ],
      "legacy_pipeline_id": 16
    },
    "6": {
      "name": "aggregate_review_context",
      "inputs": [
        "enriched_graph_id",
        "dependency_map",
        "active_methodologies",
        "review_context"
      ],
      "outputs": [
        "review_prompt_context"
      ],
      "legacy_pipeline_id": 12
    },
    "7": {
      "name": "generate_review",
      "inputs": [
        "review_prompt_context"
      ],
      "outputs": [
        "raw_review"
      ],
      "config": {
        "response_format": "structured",
        "include_graph_references": true
      },
      "legacy_pipeline_id": 9
    },
    "8": {
      "name": "structure_findings",
      "inputs": [
        "raw_review",
        "code_graph_id"
      ],
      "outputs": [
        "structured_review"
      ],
      "config": {
        "categories": [
          "security",
          "performance",
          "maintainability",
          "correctness",
          "style"
        ],
        "severity_levels": [
          "critical",
          "major",
          "minor",
          "suggestion"
        ]
      },
      "legacy_pipeline_id": 1
    },
    "9": {
      "name": "link_to_graph",
      "inputs": [
        "code_graph_id",
        "structured_review"
      ],
      "outputs": [
        "annotated_graph_id"
      ],
      "legacy_pipeline_id": 101
    }
