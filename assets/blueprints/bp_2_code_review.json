      "name": "semantic_analysis",
      "pipeline_id": 10,
      "inputs": [
        "code_graph_id"
      ],
      "outputs": [
        "enriched_graph_id"
      ],
      "config": {
        "hook_type": "OnInferRelationships",
        "semantic_depth": "deep",
        "analyze_patterns": true
      },
      "legacy_description": "ZSEI adds semantic layer to structural graph",
      "legacy_action": "TriggerHook"
    },
    "6": {
