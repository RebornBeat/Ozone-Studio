        "provisional_node_ids"
      ],
      "critical": true,
      "comment": "This is the key graph-first step - plan the structure before writing code",
      "legacy_description": "Create provisional nodes in graph BEFORE generation",
      "legacy_action": "CreateProvisionalNodes"
    },
    "6": {
      "name": "check_conflicts",
      "pipeline_id": 101,
      "inputs": [
        "provisional_graph"
      ],
      "outputs": [
        "conflict_report"
      ],
      "on_failure": {
        "action": "revise_plan",
        "goto_step": 4
      },
      "legacy_description": "Validate provisional structure against existing code",
      "legacy_action": "CheckConflicts"
    },
    "7": {
      "name": "consciousness_check",
      "pipeline_id": 40,
      "inputs": [
        "structure_plan",
        "conflict_report"
      ],
      "outputs": [
        "approval_status"
      ],
      "config": {
        "check_security_implications": true,
        "check_architectural_fit": true
      },
      "legacy_description": "Ethical and architectural review of planned code",
      "legacy_action": "EvaluateDecision"
    },
    "8": {
      "name": "load_methodologies",
      "pipeline_id": 16,
      "inputs": [
        "required_methodologies"
      ],
      "outputs": [
        "active_methodologies"
      ],
      "legacy_description": "Load code creation methodologies",
      "legacy_action": "LoadMethodologies"
    },
    "9": {
      "name": "aggregate_context",
      "pipeline_id": 12,
      "inputs": [
        "provisional_graph",
        "active_methodologies",
        "requirement_analysis"
      ],
      "outputs": [
        "generation_context"
      ],
      "legacy_description": "Build generation context with graph and methodologies",
      "legacy_action": "AggregateForTask"
    },
    "10": {
      "name": "generate_code",
      "pipeline_id": 9,
      "inputs": [
        "generation_context",
        "provisional_node_ids"
      ],
      "outputs": [
        "generated_code"
      ],
      "loop_config": {
        "iterate_over": "provisional_node_ids",
        "parallel": false,
        "order": "dependency_order"
      },
      "config": {
        "include_provisional_context": true,
        "validate_against_graph": true
      },
      "legacy_description": "Generate code for each provisional node",
      "legacy_action": "Execute"
    },
    "11": {
      "name": "validate_code",
      "pipeline_id": 101,
      "inputs": [
        "generated_code"
      ],
      "outputs": [
        "validation_result"
      ],
      "config": {
        "check_imports": true,
        "check_types": true,
        "check_dependencies": true
      },
      "legacy_description": "Validate generated code against graph constraints",
      "legacy_action": "Analyze"
    },
    "12": {
      "name": "write_files",
      "pipeline_id": 11,
      "inputs": [
        "generated_code",
        "validation_result"
      ],
      "outputs": [
        "file_paths"
      ],
      "conditional": {
        "condition": "validation_result.success",
        "on_failure": {
          "action": "regenerate",
          "goto_step": 10,
          "max_retries": 3
        }
      },
      "legacy_description": "Write validated code to files",
      "legacy_action": "CreateFile"
    },
    "13": {
      "name": "finalize_graph",
      "pipeline_id": 101,
      "inputs": [
        "provisional_node_ids",
        "file_paths"
      ],
      "outputs": [
        "final_graph"
      ],
      "on_failure": {
        "action": "rollback",
        "pipeline_id": 101,
        "inputs": [
          "provisional_node_ids"
        ]
      },
      "legacy_description": "Convert provisional nodes to permanent after successful write",
      "legacy_action": "FinalizeProvisional"
    },
    "14": {
      "name": "trigger_semantic_analysis",
      "pipeline_id": 10,
      "inputs": [
        "final_graph"
      ],
      "outputs": [
        "enriched_graph"
      ],
      "config": {
        "hook_type": "OnGraphCreated"
      },
      "legacy_description": "Add semantic layer to new code",
      "legacy_action": "TriggerHook"
    },
    "15": {
      "name": "update_project_index",
      "pipeline_id": 7,
      "inputs": [
        "file_paths",
        "enriched_graph"
      ],
      "outputs": [
        "index_status"
      ],
      "legacy_description": "Update ZSEI index with new code",
      "legacy_action": "IndexFiles"
    }
