      },
      "legacy_description": "Plan code structure with LLM",
      "legacy_action": "Execute"
    },
    "5": {
      "name": "create_provisional_nodes",
      "pipeline_id": 101,
      "inputs": [
        "structure_plan",
        "existing_graph"
      ],
      "outputs": [
