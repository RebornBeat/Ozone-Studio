      ],
      "outputs": [
        "analysis_requirements"
      ],
      "config": {
        "extract_metrics": true,
        "extract_hypotheses": true,
        "extract_visualizations": true
      },
      "legacy_pipeline_id": 100
    },
    "4": {
      "name": "plan_analysis",
      "inputs": [
        "analysis_requirements",
        "data_graphs",
        "data_metadata"
      ],
      "outputs": [
        "analysis_plan"
      ],
      "config": {
        "response_format": "json",
        "schema": "analysis_plan_schema"
      },
      "legacy_pipeline_id": 9
    },
    "5": {
      "name": "generate_analysis_code",
      "inputs": [
        "analysis_plan"
      ],
      "outputs": [
        "provisional_code"
      ],
      "legacy_pipeline_id": 101
    },
    "6": {
      "name": "execute_analysis",
      "inputs": [
        "provisional_code",
        "data_sources"
      ],
      "outputs": [
        "analysis_results",
        "execution_logs"
      ],
      "config": {
        "sandbox_type": "python",
        "timeout_seconds": 300,
        "memory_limit_mb": 1024
      },
      "legacy_pipeline_id": 101
    },
    "7": {
      "name": "process_results",
      "inputs": [
        "analysis_results",
        "analysis_requirements"
      ],
      "outputs": [
        "processed_results",
        "validation_status"
      ],
      "legacy_pipeline_id": 1
    },
    "8": {
      "name": "create_math_graph",
      "inputs": [
        "processed_results"
      ],
      "outputs": [
        "math_graph_id"
      ],
      "conditional": {
        "condition": "has_statistical_analysis"
      },
      "legacy_pipeline_id": 105
    },
    "9": {
      "name": "link_all_graphs",
      "inputs": [
        "data_graphs",
        "math_graph_id"
      ],
      "outputs": [
        "linked_analysis_graph"
      ],
      "config": {
        "hook_type": "OnCrossModalityLink"
      },
      "legacy_pipeline_id": 10
    },
    "10": {
      "name": "generate_visualizations",
      "inputs": [
        "processed_results",
        "analysis_plan"
      ],
      "outputs": [
        "visualization_code"
      ],
      "conditional": {
        "condition": "visualizations_requested"
      },
      "legacy_pipeline_id": 9
    },
    "11": {
      "name": "aggregate_context",
      "inputs": [
        "linked_analysis_graph",
        "processed_results",
        "visualization_code"
      ],
      "outputs": [
        "report_context"
      ],
      "legacy_pipeline_id": 12
    },
    "12": {
      "name": "generate_report",
      "inputs": [
        "report_context"
      ],
      "outputs": [
        "analysis_report"
      ],
      "config": {
        "include_methodology": true,
        "include_limitations": true,
        "include_recommendations": true
      },
      "legacy_pipeline_id": 9
    },
    "13": {
      "name": "finalize_code",
      "inputs": [
        "provisional_code"
      ],
      "outputs": [
        "final_code_graph"
      ],
      "legacy_pipeline_id": 101
    },
    "14": {
      "name": "write_outputs",
      "inputs": [
        "analysis_report",
        "final_code_graph",
        "visualization_code"
      ],
      "outputs": [
        "output_paths"
