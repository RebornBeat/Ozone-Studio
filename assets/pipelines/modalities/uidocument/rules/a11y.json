{
 "pack": {
  "id": "a11y",
  "version": "0.1.0",
  "flavor": "a11y-json",
  "spec_refs": [
   "Chrome DevTools Protocol Accessibility domain",
   "WAI-ARIA 1.2",
   "Accessible Name and Description Computation 1.2",
   "Playwright accessibility snapshot"
  ]
 },
 "rules": [
  {
   "id": "a11y.struct.node",
   "family": "structure",
   "when": {
    "scope": "once"
   },
   "emit": {
    "builtin": "node_per_element"
   },
   "confidence": "certain",
   "source": "Chrome DevTools Protocol Accessibility.getFullAXTree",
   "rationale": "The adapter creates exactly one graph node per accessibility node (plus the Document node); the tree is the node's `parent`."
  },
  {
   "id": "a11y.source.browser",
   "family": "structure",
   "when": {
    "scope": "once"
   },
   "emit": {
    "flag": "source",
    "value": "browser",
    "scope": "document"
   },
   "confidence": "certain",
   "source": "Chrome DevTools Protocol Accessibility.getFullAXTree",
   "rationale": "The facts are the BROWSER's own accessibility computation (role, name, state), not a reimplementation: confidence is certain."
  },
  {
   "id": "a11y.role",
   "family": "a11y",
   "when": {
    "selector": "*",
    "has_attr": [
     "role"
    ]
   },
   "emit": {
    "flag": "role",
    "value_from": "attr:role"
   },
   "confidence": "certain",
   "source": "Chrome DevTools Protocol Accessibility.getFullAXTree / ARIA 1.2",
   "rationale": "The browser-computed role, verbatim (original case kept; the tag is its lower-cased form)."
  },
  {
   "id": "a11y.name.label",
   "family": "a11y",
   "when": {
    "selector": "*",
    "has_attr": [
     "aria-label"
    ]
   },
   "emit": {
    "flag": "name",
    "value_from": "attr:aria-label"
   },
   "confidence": "certain",
   "source": "Chrome DevTools Protocol Accessibility.getFullAXTree / Accessible Name and Description Computation 1.2",
   "rationale": "The browser-computed accessible name, verbatim."
  },
  {
   "id": "a11y.name.text",
   "family": "a11y",
   "when": {
    "selector": "statictext,text,inlinetextbox",
    "text_matches": "\\S"
   },
   "emit": {
    "flag": "name",
    "value_from": "text"
   },
   "confidence": "certain",
   "source": "Chrome DevTools Protocol Accessibility.getFullAXTree",
   "rationale": "For text nodes the name IS the text."
  },
  {
   "id": "a11y.description",
   "family": "a11y",
   "when": {
    "selector": "*",
    "has_attr": [
     "title"
    ]
   },
   "emit": {
    "flag": "description",
    "value_from": "attr:title"
   },
   "confidence": "certain",
   "source": "Chrome DevTools Protocol Accessibility.getFullAXTree",
   "rationale": "The browser-computed accessible description, verbatim."
  },
  {
   "id": "a11y.state.ignored",
   "family": "state",
   "when": {
    "selector": "[ignored=\"true\"]"
   },
   "emit": {
    "flag": "ignored",
    "value": true
   },
   "confidence": "certain",
   "source": "Chrome DevTools Protocol Accessibility.getFullAXTree",
   "rationale": "An ignored node is not exposed to assistive technology."
  },
  {
   "id": "a11y.vis.ignored",
   "family": "visibility",
   "when": {
    "selector": "[ignored=\"true\"]"
   },
   "emit": {
    "flag": "visibility_hidden",
    "value": true
   },
   "confidence": "certain",
   "source": "Chrome DevTools Protocol Accessibility.getFullAXTree",
   "rationale": "An ignored node is not exposed to assistive technology. Only the node itself is hidden: its descendants stay in the tree (Chrome lists them under the ignored node) and keep their own visibility."
  },
  {
   "id": "a11y.vis.hidden",
   "family": "visibility",
   "when": {
    "selector": "[hidden=\"true\"]"
   },
   "emit": {
    "flag": "display_none",
    "value": true
   },
   "confidence": "certain",
   "source": "Chrome DevTools Protocol Accessibility.getFullAXTree / aria-hidden",
   "rationale": "A node whose hidden property is true removes its whole subtree from what a user perceives."
  },
  {
   "id": "a11y.state.focusable",
   "family": "state",
   "when": {
    "selector": "[focusable=\"true\"]"
   },
   "emit": {
    "flag": "focusable",
    "value": true
   },
   "confidence": "certain",
   "source": "Chrome DevTools Protocol Accessibility.getFullAXTree / ARIA 1.2",
   "rationale": "The property 'focusable' is true."
  },
  {
