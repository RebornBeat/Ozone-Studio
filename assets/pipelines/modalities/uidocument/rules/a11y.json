  {
   "id": "a11y.interact.widget",
   "family": "interactability",
   "when": {
    "selector": "button,link,textbox,searchbox,combobox,checkbox,radio,switch,slider,spinbutton,menuitem,menuitemcheckbox,menuitemradio,tab,option,treeitem"
   },
   "emit": {
    "flag": "interactable_base",
    "value": true
   },
   "confidence": "certain",
   "source": "ARIA 1.2 widget roles",
   "rationale": "Widget roles are interactive by definition."
  },
  {
   "id": "a11y.interact.focusable",
   "family": "interactability",
   "when": {
    "selector": "[focusable=\"true\"]"
   },
   "emit": {
    "flag": "interactable_base",
    "value": true
   },
   "confidence": "derived",
   "source": "Chrome DevTools Protocol Accessibility.getFullAXTree",
   "rationale": "Focusable nodes accept keyboard input; the final rule applies disabled / hidden state."
  },
  {
   "id": "a11y.safety.suspicious-instruction-text",
   "family": "safety",
   "when": {
    "selector": "*"
   },
   "emit": {
    "builtin": "suspicious_text"
   },
   "confidence": "heuristic",
   "source": "Prompt-injection indicators",
   "rationale": "Flags (never removes) names / descriptions / text that address an AI reader. All accessibility strings are untrusted page data. Values of fields are never emitted at all (only their length).",
   "evidence": [
    "name / description / text matched a known injection pattern"
   ]
  },
