   },
   "confidence": "certain",
   "source": "Chrome DevTools Protocol Accessibility.getFullAXTree relatedNodes / ARIA 1.2",
   "rationale": "Documentation entry: 'labelledby' relations are emitted by the adapter as LabelFor edges (the relatedNodes carry backend DOM ids, which the data vocabulary cannot resolve). The adapter records the rule id on each edge."
  },
